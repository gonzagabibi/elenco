<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ELENCO — Monte seu time dos sonhos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0B0E;
    --panel:#151319;
    --panel-2:#1C1922;
    --burgundy:#4A1023;
    --gold:#E8B54D;
    --gold-dim:#8a6c2e;
    --ink:#F2EDE4;
    --ink-dim:#9A94A3;
    --violet:#6C5B7B;
    --line:#2A2732;
    --good:#7FBF8E;
    --bad:#C96A6A;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(circle at 15% 0%, rgba(74,16,35,0.35), transparent 45%),
      radial-gradient(circle at 85% 10%, rgba(108,91,123,0.25), transparent 40%),
      var(--bg);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding:0 0 80px 0;
  }
  .wrap{max-width:1100px;margin:0 auto;padding:32px 20px 0;}
  .hidden{display:none !important;}

  header{
    display:flex;justify-content:space-between;align-items:flex-end;
    border-bottom:1px solid var(--line);
    padding-bottom:18px;margin-bottom:28px;
    flex-wrap:wrap;gap:16px;
  }
  .brand{display:flex;flex-direction:column;}
  .brand .eyebrow{
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;
    color:var(--gold);text-transform:uppercase;margin-bottom:6px;
  }
  .brand h1{
    font-family:'Bebas Neue',sans-serif;font-size:52px;line-height:.85;
    letter-spacing:.02em;margin:0;color:var(--ink);
  }
  .brand h1 span{color:var(--gold);}
  .scorebox{
    background:var(--panel);border:1px solid var(--line);border-radius:4px;
    padding:12px 20px;text-align:right;min-width:170px;
  }
  .scorebox .label{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-dim);letter-spacing:.12em;text-transform:uppercase;}
  .scorebox .value{font-family:'Bebas Neue',sans-serif;font-size:38px;color:var(--gold);line-height:1;}

  button{
    font-family:'Inter',sans-serif;font-weight:700;font-size:14px;
    border:none;border-radius:3px;padding:14px 26px;cursor:pointer;
    background:var(--gold);color:#1a1408;letter-spacing:.02em;
    transition:transform .12s ease, box-shadow .12s ease;
  }
  button:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(232,181,77,.25);}
  button:active{transform:translateY(0);}
  button.ghost{background:transparent;color:var(--gold);border:1px solid var(--gold-dim);}
  button.ghost:hover{box-shadow:none;background:rgba(232,181,77,.08);}
  button:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none;}

  #coverScreen{
    min-height:90vh;display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:40px 20px;
  }
  #coverScreen .eyebrow{
    font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.2em;color:var(--gold);
    text-transform:uppercase;margin-bottom:14px;
  }
  #coverScreen h1{
    font-family:'Bebas Neue',sans-serif;font-size:88px;line-height:.85;margin:0 0 18px;letter-spacing:.02em;
  }
  #coverScreen h1 span{color:var(--gold);}
  #coverScreen p{max-width:560px;color:var(--ink-dim);font-size:15px;line-height:1.7;margin:0 0 30px;}
  .how-it-works{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin-bottom:34px;max-width:820px;}
  .hiw-card{background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:16px 18px;width:180px;text-align:left;}
  .hiw-card .n{font-family:'Bebas Neue',sans-serif;color:var(--gold);font-size:26px;}
  .hiw-card .t{font-weight:700;font-size:13px;margin:4px 0 6px;}
  .hiw-card .d{font-size:12px;color:var(--ink-dim);line-height:1.5;}

  .draw-stage{
    background:var(--panel);border:1px solid var(--line);border-radius:6px;
    padding:28px;margin-bottom:24px;display:flex;align-items:center;gap:20px;flex-wrap:wrap;
  }
  .ticket{
    position:relative;background:var(--burgundy);border-radius:4px;
    padding:22px 30px;min-width:260px;flex:1;
    border:1px dashed var(--gold-dim);
  }
  .ticket.violet{background:var(--panel-2);border-color:var(--violet);}
  .ticket .tlabel{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--gold);letter-spacing:.15em;text-transform:uppercase;}
  .ticket .tgenre{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--ink);margin-top:4px;letter-spacing:.02em;}
  .ticket .thint{font-size:12px;color:#d8c9cf;margin-top:6px;}
  .ticket.violet .thint{color:var(--ink-dim);}
  .draw-actions{display:flex;flex-direction:column;gap:8px;align-items:center;}
  .redraw-count{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-dim);}

  .choice-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px;margin-top:16px;}
  .choice-card{
    background:var(--panel);border:1px solid var(--gold-dim);border-radius:5px;padding:14px;cursor:pointer;
    transition:border-color .12s, background .12s;
  }
  .choice-card:hover{border-color:var(--gold);background:rgba(232,181,77,.07);}
  .choice-card .cname{font-weight:800;font-size:14.5px;margin-bottom:8px;}
  .choice-scores{display:flex;flex-direction:column;gap:4px;}
  .cscore-row{display:flex;align-items:center;gap:6px;font-size:10.5px;}
  .cscore-label{font-family:'JetBrains Mono',monospace;color:var(--ink-dim);width:78px;flex-shrink:0;text-transform:uppercase;letter-spacing:.04em;}
  .cscore-bar{flex:1;height:5px;background:var(--line);border-radius:3px;overflow:hidden;}
  .cscore-fill{height:100%;background:var(--gold);}
  .cscore-val{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold);width:22px;text-align:right;}
  .scores-legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:14px;font-size:11px;color:var(--ink-dim);}
  .scores-legend b{color:var(--ink);}

  .roles-title{font-family:'Bebas Neue',sans-serif;font-size:26px;color:var(--ink);letter-spacing:.02em;margin:0 0 4px;}
  .roles-sub{color:var(--ink-dim);font-size:13px;margin:0 0 20px;}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;margin-bottom:20px;}
  .slot{
    background:var(--panel);border:1px solid var(--line);border-radius:5px;
    padding:16px;min-height:150px;display:flex;flex-direction:column;justify-content:space-between;
    transition:border-color .15s ease, background .15s ease;position:relative;overflow:hidden;
  }
  .slot.assignable{border-color:var(--gold);cursor:pointer;}
  .slot.assignable:hover{background:rgba(232,181,77,.08);}
  .slot .role-name{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--violet);letter-spacing:.1em;text-transform:uppercase;}
  .slot .empty-cta{color:var(--ink-dim);font-size:13px;margin-top:auto;}
  .slot .filled{display:flex;align-items:center;gap:12px;margin-top:8px;}
  .avatar{
    width:46px;height:46px;border-radius:50%;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:18px;color:#111;
  }
  .actor-name{font-weight:700;font-size:14px;color:var(--ink);}
  .actor-role{font-size:11.5px;color:var(--ink-dim);margin-top:1px;}
  .stat-row{display:flex;gap:6px;margin-top:12px;font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--gold);flex-wrap:wrap;}
  .stat-chip{background:rgba(232,181,77,.1);border:1px solid var(--gold-dim);border-radius:3px;padding:3px 6px;}

  .alloc-banner{
    background:rgba(232,181,77,.1);border:1px solid var(--gold-dim);border-radius:5px;
    padding:12px 18px;margin-bottom:18px;font-size:14px;color:var(--ink);
  }
  .alloc-banner strong{color:var(--gold);}

  .event-box, .result{
    background:var(--panel);border:1px solid var(--gold-dim);border-radius:6px;padding:28px;margin-top:12px;
  }
  .event-box h2, .result h2{font-family:'Bebas Neue',sans-serif;font-size:32px;margin:0 0 10px;color:var(--gold);}
  .event-box p, .result p{color:var(--ink-dim);font-size:14px;line-height:1.6;}
  .event-options{display:flex;flex-direction:column;gap:10px;margin-top:16px;}
  .event-opt{
    text-align:left;background:var(--panel-2);border:1px solid var(--line);border-radius:5px;
    padding:14px 16px;cursor:pointer;color:var(--ink);
  }
  .event-opt:hover{border-color:var(--gold-dim);}
  .event-opt .eo-title{font-weight:700;font-size:13.5px;}
  .event-opt .eo-desc{font-size:12px;color:var(--ink-dim);margin-top:3px;}
  .event-outcome{margin-top:16px;padding:14px 16px;border-radius:5px;font-size:13.5px;}
  .event-outcome.good{background:rgba(127,191,142,.1);border:1px solid var(--good);color:var(--good);}
  .event-outcome.bad{background:rgba(201,106,106,.1);border:1px solid var(--bad);color:var(--bad);}

  .breakdown{display:flex;gap:20px;margin-top:16px;flex-wrap:wrap;}
  .bd-item{background:var(--panel-2);border:1px solid var(--line);border-radius:5px;padding:12px 18px;}
  .bd-item .bd-label{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-dim);letter-spacing:.1em;text-transform:uppercase;}
  .bd-item .bd-val{font-family:'Bebas Neue',sans-serif;font-size:26px;color:var(--ink);}
  .synopsis{
    margin-top:22px;background:var(--panel-2);border-left:3px solid var(--gold);border-radius:4px;
    padding:20px 22px;font-size:14px;line-height:1.8;color:var(--ink);
  }
  .synopsis .syn-label{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gold);letter-spacing:.15em;text-transform:uppercase;margin-bottom:10px;}

  footer.actions{display:flex;justify-content:center;margin-top:30px;gap:12px;}
  @media(max-width:600px){
    #coverScreen h1{font-size:56px;}
    .brand h1{font-size:38px;}
    .scorebox{text-align:left;}
  }
</style>
</head>
<body>

<div id="coverScreen">
  <div class="eyebrow">Fantasy Studio · protótipo</div>
  <h1>ELENC<span>O</span></h1>
  <p>Você é o(a) produtor(a). Sorteia o gênero do filme, sorteia atores e atrizes de qualquer época, monta seu elenco dos sonhos, sobrevive a uma crise de orçamento e recebe a sinopse do filme que você acabou de criar.</p>
  <div class="how-it-works">
    <div class="hiw-card"><div class="n">01</div><div class="t">Sorteie o gênero</div><div class="d">Terror, comédia, drama... você não escolhe, o destino escolhe (com 1 direito de re-sortear).</div></div>
    <div class="hiw-card"><div class="n">02</div><div class="t">Monte o elenco</div><div class="d">Sorteie categorias, escolha entre as opções que aparecem e aloque em qualquer posição do time.</div></div>
    <div class="hiw-card"><div class="n">03</div><div class="t">Sobreviva à produção</div><div class="d">Um evento de orçamento vai testar suas decisões — e mexer na pontuação final.</div></div>
    <div class="hiw-card"><div class="n">04</div><div class="t">Veja o resultado</div><div class="d">Pontuação final e uma sinopse gerada com o elenco que você escalou.</div></div>
  </div>
  <button id="startBtn">🎬 Começar a produção</button>
</div>

<div class="wrap hidden" id="appScreen">

  <header>
    <div class="brand">
      <span class="eyebrow">Fantasy Studio · protótipo</span>
      <h1>ELENC<span>O</span></h1>
    </div>
    <div class="scorebox">
      <div class="label">Pontuação do time</div>
      <div class="value" id="scoreTotal">0</div>
    </div>
  </header>

  <div class="draw-stage" id="genreStage">
    <div class="ticket">
      <div class="tlabel">Gênero sorteado</div>
      <div class="tgenre" id="genreLabel">???</div>
      <div class="thint" id="genreHint">clique em sortear pra descobrir o filme que você vai produzir</div>
    </div>
    <div class="draw-actions">
      <button id="drawBtn">🎬 Sortear gênero</button>
      <span class="redraw-count" id="genreRedrawInfo">1 re-sorteio disponível</span>
    </div>
  </div>

  <div class="draw-stage" id="drawPersonStage">
    <div class="ticket violet" style="flex:2;">
      <div class="tlabel" id="categoryLabel">Categoria sorteada</div>
      <div class="tgenre" id="personLabel" style="font-size:28px;">???</div>
      <div class="thint" id="personHint">sorteie uma categoria pra revelar as opções</div>
      <div class="choice-grid hidden" id="personChoices"></div>
    </div>
    <div class="draw-actions">
      <button id="drawPersonBtn" disabled>🎲 Sortear categoria</button>
      <span class="redraw-count" id="catRedrawInfo">2 re-sorteios disponíveis</span>
    </div>
  </div>
  <div class="scores-legend">
    <span><b>Profissionalismo</b>: consistência e dificuldade dos personagens que já fez</span>
    <span><b>Cachê</b>: valor de mercado atual</span>
    <span><b>Prestígio</b>: reconhecimento por crítica/prêmios</span>
  </div>

  <div class="alloc-banner hidden" id="allocBanner"></div>

  <h2 class="roles-title" style="margin-top:28px;">Sua escalação</h2>
  <p class="roles-sub">As posições vão sendo preenchidas conforme você sorteia e aloca cada pessoa. Sem volta atrás!</p>
  <div class="grid" id="rolesGrid"></div>

  <footer class="actions">
    <button id="eventBtn" class="ghost hidden">💰 Evento de produção</button>
  </footer>

  <div class="event-box hidden" id="eventBox">
    <h2>Corte de orçamento</h2>
    <p id="eventText"></p>
    <div class="event-options" id="eventOptions"></div>
    <div class="event-outcome hidden" id="eventOutcome"></div>
  </div>

  <footer class="actions">
    <button id="resultBtn" class="ghost hidden">🏆 Ver resultado do filme</button>
  </footer>

  <div class="result hidden" id="resultBox">
    <h2 id="resultTitle"></h2>
    <p id="resultText"></p>
    <div class="breakdown" id="breakdown"></div>
    <div class="synopsis">
      <div class="syn-label">Sinopse</div>
      <div id="synopsisText"></div>
    </div>
  </div>

</div>

<script>
const GENRES = [
  {name:"Terror", hint:"suspense, sustos e um vilão que ninguém esquece", synVerb:"sobreviver a uma noite que não deveria ter começado"},
  {name:"Comédia Romântica", hint:"clichê proposital, química é tudo", synVerb:"desvendar se aquilo era só coincidência ou destino"},
  {name:"Ação/Blockbuster", hint:"explosões, carisma e uma cena pós-créditos", synVerb:"impedir que tudo desmorone em 48 horas"},
  {name:"Drama Premiado", hint:"pensando já na temporada de premiações", synVerb:"encarar um segredo de família que muda tudo"},
  {name:"Musical", hint:"se não canta, não entra", synVerb:"provar que a voz consegue o que as palavras não conseguem"},
  {name:"Suspense Psicológico", hint:"ninguém é quem parece ser", synVerb:"descobrir em quem confiar antes que seja tarde demais"}
];

const ROLES = [
  "Ator/Atriz principal","Irmão(ã) do personagem principal","Pai","Mãe",
  "Melhor amigo(a)","Par romântico","Terceira pessoa do triângulo amoroso",
  "Vilão","Vilão que se torna bonzinho no final"
];

const CATEGORIES = [
  {cat:"Drama premiado · veterano(a)", people:[
    {name:"Meryl Streep", prof:10, cache:7, prestige:10},
    {name:"Denzel Washington", prof:9, cache:8, prestige:9},
  ]},
  {cat:"Ascensão indie/premiado", people:[
    {name:"Timothée Chalamet", prof:8, cache:8, prestige:8},
    {name:"Saoirse Ronan", prof:8, cache:6, prestige:8},
  ]},
  {cat:"Terror moderno", people:[
    {name:"Anya Taylor-Joy", prof:7, cache:7, prestige:6},
    {name:"Florence Pugh", prof:8, cache:7, prestige:8},
  ]},
  {cat:"Vilão clássico de terror", people:[
    {name:"Anthony Hopkins", prof:10, cache:5, prestige:10},
  ]},
  {cat:"It girl 2010s", people:[
    {name:"Margot Robbie", prof:8, cache:9, prestige:7},
    {name:"Jennifer Lawrence", prof:8, cache:8, prestige:8},
  ]},
  {cat:"Galã atual", people:[
    {name:"Glen Powell", prof:6, cache:7, prestige:5},
    {name:"Jacob Elordi", prof:6, cache:6, prestige:5},
  ]},
  {cat:"It girl atual", people:[
    {name:"Sydney Sweeney", prof:6, cache:7, prestige:5},
  ]},
  {cat:"Super-herói atual", people:[
    {name:"Tom Holland", prof:6, cache:9, prestige:5},
  ]},
  {cat:"Hot em blockbusters atuais", people:[
    {name:"Zendaya", prof:7, cache:8, prestige:7},
  ]},
  {cat:"Comediante 2000s/2010s", people:[
    {name:"Adam Sandler", prof:5, cache:7, prestige:4},
  ]},
  {cat:"Galã 1990s", people:[
    {name:"Brad Pitt", prof:9, cache:8, prestige:8},
  ]},
  {cat:"It girl 2000s", people:[
    {name:"Megan Fox", prof:4, cache:6, prestige:3},
  ]},
  {cat:"Veterano(a) premiado(a)", people:[
    {name:"Tom Hanks", prof:9, cache:8, prestige:9},
    {name:"Cate Blanchett", prof:10, cache:6, prestige:10},
  ]},
  {cat:"Vilão de blockbuster/ação", people:[
    {name:"Javier Bardem", prof:8, cache:6, prestige:8},
  ]},
  {cat:"Scream queen clássica", people:[
    {name:"Jamie Lee Curtis", prof:7, cache:5, prestige:7},
  ]},
  {cat:"Vilão cômico/carismático", people:[
    {name:"Jack Nicholson", prof:9, cache:6, prestige:9},
  ]},
  {cat:"It girl 1990s", people:[
    {name:"Winona Ryder", prof:6, cache:5, prestige:6},
  ]},
  {cat:"Hot em séries de ação (streaming)", people:[
    {name:"Pedro Pascal", prof:7, cache:9, prestige:6},
  ]},
  {cat:"Hot em séries teen (streaming)", people:[
    {name:"Jenna Ortega", prof:6, cache:8, prestige:5},
  ]},
  {cat:"Hot em filmes premiados atuais", people:[
    {name:"Barry Keoghan", prof:7, cache:7, prestige:7},
  ]},
  {cat:"Melhor amigo(a) cômico", people:[
    {name:"Rebel Wilson", prof:5, cache:5, prestige:3},
  ]},
  {cat:"Coadjuvante icônico", people:[
    {name:"Samuel L. Jackson", prof:7, cache:8, prestige:6},
  ]},
];

const AV_COLORS = ["#E8B54D","#6C5B7B","#7FBF8E","#B85C7A","#5C8AB8","#C9975A"];

const EVENT_OPTIONS = [
  {title:"Cortar do elenco secundário", desc:"Reduz o cachê pago pros papéis de apoio.",
   effect:{good:true, msg:"Corte cirúrgico — o time principal segue intacto e o filme mantém a força.", delta:4}},
  {title:"Cortar da campanha de marketing", desc:"Menos divulgação, mais orçamento pro elenco.",
   effect:{good:false, msg:"O filme fica ótimo, mas quase ninguém fica sabendo que ele existe na estreia.", delta:-3}},
  {title:"Cortar dos efeitos especiais", desc:"Aposta que a atuação segura o filme sozinha.",
   effect:{good:true, msg:"Funcionou — a crítica elogia o texto e o elenco, ninguém sentiu falta da explosão a mais.", delta:3}},
  {title:"Cortar do próprio protagonista", desc:"Renegociar o cachê da estrela principal.",
   effect:{good:false, msg:"O clima no set nunca mais foi o mesmo. A tensão vaza pra imprensa antes da estreia.", delta:-6}},
];

let selectedGenre = null;
let genreRedraws = 1;
let catRedraws = 2;
let cast = {};
let usedCategories = new Set();
let pendingCategory = null;
let pendingPerson = null;
let eventDelta = 0;

const genreLabel = document.getElementById('genreLabel');
const genreHint = document.getElementById('genreHint');
const genreRedrawInfo = document.getElementById('genreRedrawInfo');
const rolesGrid = document.getElementById('rolesGrid');
const scoreTotal = document.getElementById('scoreTotal');
const resultBtn = document.getElementById('resultBtn');
const resultBox = document.getElementById('resultBox');
const drawPersonBtn = document.getElementById('drawPersonBtn');
const catRedrawInfo = document.getElementById('catRedrawInfo');
const categoryLabel = document.getElementById('categoryLabel');
const personLabel = document.getElementById('personLabel');
const personHint = document.getElementById('personHint');
const personChoices = document.getElementById('personChoices');
const allocBanner = document.getElementById('allocBanner');
const eventBtn = document.getElementById('eventBtn');
const eventBox = document.getElementById('eventBox');
const eventOptions = document.getElementById('eventOptions');
const eventOutcome = document.getElementById('eventOutcome');

document.getElementById('startBtn').onclick = ()=>{
  document.getElementById('coverScreen').classList.add('hidden');
  document.getElementById('appScreen').classList.remove('hidden');
};

function initials(name){ return name.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase(); }
function remainingRoles(){ return ROLES.filter(r=>!cast[r]); }

function scoreBar(label, val){
  return `<div class="cscore-row">
    <span class="cscore-label">${label}</span>
    <span class="cscore-bar"><span class="cscore-fill" style="width:${val*10}%"></span></span>
    <span class="cscore-val">${val}</span>
  </div>`;
}

document.getElementById('drawBtn').onclick = ()=>{
  if(selectedGenre && genreRedraws <= 0) return;
  if(selectedGenre){ genreRedraws--; }
  const g = GENRES[Math.floor(Math.random()*GENRES.length)];
  selectedGenre = g;
  genreLabel.textContent = g.name;
  genreHint.textContent = g.hint;
  genreRedrawInfo.textContent = genreRedraws > 0 ? `${genreRedraws} re-sorteio disponível` : 'sem re-sorteios restantes';
  document.getElementById('drawBtn').textContent = '🔁 Re-sortear gênero';
  if(genreRedraws <= 0) document.getElementById('drawBtn').disabled = true;
  drawPersonBtn.disabled = false;
};

function wireInitialDraw(){
  drawPersonBtn.onclick = ()=>{
    if(pendingCategory || pendingPerson) return;
    if(remainingRoles().length === 0) return;
    const available = CATEGORIES.filter(c=>!usedCategories.has(c.cat));
    const pool = available.length ? available : CATEGORIES;
    const chosenCat = pool[Math.floor(Math.random()*pool.length)];
    pendingCategory = chosenCat;
    showCategoryChoices(chosenCat);
  };
}
wireInitialDraw();

function showCategoryChoices(chosenCat){
  categoryLabel.textContent = chosenCat.cat;
  personLabel.textContent = 'Escolha alguém dessa categoria:';
  personHint.textContent = '';
  personChoices.classList.remove('hidden');
  personChoices.innerHTML = '';
  chosenCat.people.forEach(person=>{
    const card = document.createElement('div');
    card.className = 'choice-card';
    card.innerHTML = `
      <div class="cname">${person.name}</div>
      <div class="choice-scores">
        ${scoreBar('Profission.', person.prof)}
        ${scoreBar('Cachê', person.cache)}
        ${scoreBar('Prestígio', person.prestige)}
      </div>
    `;
    card.onclick = ()=>confirmPersonPick(person, chosenCat);
    personChoices.appendChild(card);
  });

  drawPersonBtn.textContent = '🔁 Re-sortear categoria';
  drawPersonBtn.disabled = catRedraws <= 0;
  drawPersonBtn.onclick = ()=>{
    if(catRedraws <= 0) return;
    catRedraws--;
    catRedrawInfo.textContent = catRedraws > 0 ? `${catRedraws} re-sorteios disponíveis` : 'sem re-sorteios restantes';
    const available = CATEGORIES.filter(c=>!usedCategories.has(c.cat) && c.cat !== chosenCat.cat);
    const pool = available.length ? available : CATEGORIES;
    const newCat = pool[Math.floor(Math.random()*pool.length)];
    pendingCategory = newCat;
    showCategoryChoices(newCat);
    if(catRedraws <= 0) drawPersonBtn.disabled = true;
  };
}

function confirmPersonPick(person, chosenCat){
  usedCategories.add(chosenCat.cat);
  pendingPerson = {...person, credit: chosenCat.cat};
  personChoices.classList.add('hidden');
  personChoices.innerHTML = '';
  personLabel.textContent = person.name;
  personHint.textContent = 'escolha em qual posição essa pessoa vai entrar, aí embaixo';
  drawPersonBtn.disabled = true;

  allocBanner.classList.remove('hidden');
  allocBanner.innerHTML = `Agora escolha em qual posição <strong>${person.name}</strong> vai entrar`;
  renderRoles();
  allocBanner.scrollIntoView({behavior:'smooth', block:'center'});
}

function renderRoles(){
  rolesGrid.innerHTML = '';
  const waitingAlloc = !!pendingPerson;
  ROLES.forEach(role=>{
    const actor = cast[role];
    const slot = document.createElement('div');
    slot.className = 'slot';
    if(actor){
      const color = AV_COLORS[ROLES.indexOf(role) % AV_COLORS.length];
      slot.innerHTML = `
        <div class="role-name">${role}</div>
        <div class="filled">
          <div class="avatar" style="background:${color}">${initials(actor.name)}</div>
          <div>
            <div class="actor-name">${actor.name}</div>
            <div class="actor-role">${actor.credit}</div>
          </div>
        </div>
        <div class="stat-row">
          <span class="stat-chip">prof ${actor.prof}</span>
          <span class="stat-chip">cachê ${actor.cache}</span>
          <span class="stat-chip">prestígio ${actor.prestige}</span>
        </div>
      `;
    } else if(waitingAlloc){
      slot.classList.add('assignable');
      slot.onclick = ()=>assignPending(role);
      slot.innerHTML = `<div class="role-name">${role}</div><div class="empty-cta">👉 colocar ${pendingPerson.name} aqui</div>`;
    } else {
      slot.innerHTML = `<div class="role-name">${role}</div><div class="empty-cta">aguardando sorteio</div>`;
    }
    rolesGrid.appendChild(slot);
  });
  updateScore();
}

function assignPending(role){
  if(!pendingPerson) return;
  cast[role] = pendingPerson;
  pendingPerson = null;
  pendingCategory = null;
  allocBanner.classList.add('hidden');
  personLabel.textContent = '???';
  personHint.textContent = remainingRoles().length
    ? 'sorteie a próxima categoria pra continuar montando o time'
    : 'escalação completa!';
  categoryLabel.textContent = 'Categoria sorteada';
  drawPersonBtn.textContent = '🎲 Sortear categoria';
  drawPersonBtn.disabled = remainingRoles().length === 0;
  wireInitialDraw();
  renderRoles();
  if(remainingRoles().length === 0){
    eventBtn.classList.remove('hidden');
  }
}

function updateScore(){
  const actors = Object.values(cast);
  let total = 0;
  actors.forEach(a=> total += a.prof + a.cache + a.prestige);
  total += eventDelta;
  scoreTotal.textContent = total;
}

eventBtn.onclick = ()=>{
  eventBox.classList.remove('hidden');
  eventBtn.classList.add('hidden');
  document.getElementById('eventText').textContent =
    'O estúdio cortou US$ 100 mil do orçamento em cima da hora. De onde você tira o dinheiro?';
  eventOptions.innerHTML = '';
  eventOutcome.classList.add('hidden');
  EVENT_OPTIONS.forEach(opt=>{
    const btn = document.createElement('div');
    btn.className = 'event-opt';
    btn.innerHTML = `<div class="eo-title">${opt.title}</div><div class="eo-desc">${opt.desc}</div>`;
    btn.onclick = ()=>{
      eventDelta = opt.effect.delta;
      eventOutcome.classList.remove('hidden');
      eventOutcome.className = 'event-outcome ' + (opt.effect.good ? 'good' : 'bad');
      eventOutcome.textContent = opt.effect.msg + ` (${opt.effect.delta > 0 ? '+' : ''}${opt.effect.delta} na pontuação final)`;
      Array.from(eventOptions.children).forEach(c=>c.style.pointerEvents='none');
      updateScore();
      resultBtn.classList.remove('hidden');
    };
    eventOptions.appendChild(btn);
  });
  eventBox.scrollIntoView({behavior:'smooth', block:'center'});
};

resultBtn.onclick = ()=>{
  const actors = Object.values(cast);
  const prof = actors.reduce((s,a)=>s+a.prof,0);
  const cache = actors.reduce((s,a)=>s+a.cache,0);
  const prestige = actors.reduce((s,a)=>s+a.prestige,0);
  const total = prof+cache+prestige+eventDelta;

  document.getElementById('breakdown').innerHTML = `
    <div class="bd-item"><div class="bd-label">Profissionalismo</div><div class="bd-val">${prof}</div></div>
    <div class="bd-item"><div class="bd-label">Cachê</div><div class="bd-val">${cache}</div></div>
    <div class="bd-item"><div class="bd-label">Prestígio</div><div class="bd-val">${prestige}</div></div>
    <div class="bd-item"><div class="bd-label">Evento</div><div class="bd-val">${eventDelta>0?'+':''}${eventDelta}</div></div>
    <div class="bd-item"><div class="bd-label">Total</div><div class="bd-val">${total}</div></div>
  `;

  let verdict;
  if(prestige >= cache && prestige >= prof) verdict = "Esse elenco cheira temporada de premiação — provável indicado a Oscar, bilheteria de nicho.";
  else if(cache >= prof && cache >= prestige) verdict = "Blockbuster garantido — vai bombar no fim de semana de estreia, crítica é o de menos.";
  else verdict = "Filme sólido tecnicamente — atuações consistentes carregam a produção mesmo sem ser um fenômeno de bilheteria.";

  document.getElementById('resultTitle').textContent = `Seu filme de ${selectedGenre ? selectedGenre.name : "gênero indefinido"} está pronto`;
  document.getElementById('resultText').textContent = verdict;
  document.getElementById('synopsisText').textContent = buildSynopsis();

  eventBtn.classList.add('hidden');
  resultBtn.classList.add('hidden');
  resultBox.classList.remove('hidden');
  resultBox.scrollIntoView({behavior:'smooth', block:'center'});
};

function buildSynopsis(){
  const g = selectedGenre || GENRES[0];
  const princ = cast["Ator/Atriz principal"];
  const par = cast["Par romântico"];
  const vilao = cast["Vilão"];
  const vilaoBom = cast["Vilão que se torna bonzinho no final"];
  const amigo = cast["Melhor amigo(a)"];
  const irmao = cast["Irmão(ã) do personagem principal"];
  const mae = cast["Mãe"];
  const pai = cast["Pai"];
  const triangulo = cast["Terceira pessoa do triângulo amoroso"];

  let s = `${princ.name} vive o centro de um ${g.name.toLowerCase()} que exige ${g.synVerb}. `;
  if(pai || mae){
    s += `Em casa, ${[pai?pai.name:null, mae?mae.name:null].filter(Boolean).join(" e ")} tentam segurar as pontas enquanto tudo desmorona ao redor. `;
  }
  if(irmao){ s += `${irmao.name} entra como a única pessoa disposta a dizer a verdade, mesmo quando ninguém quer ouvir. `; }
  if(amigo){ s += `${amigo.name} é o alívio cômico que ninguém sabia que precisava até precisar de verdade. `; }
  if(par && triangulo){
    s += `No meio disso, ${princ.name} se divide entre ${par.name} e ${triangulo.name} — e nem todo mundo vai sair ileso dessa escolha. `;
  } else if(par){
    s += `${par.name} entra como o par romântico que muda tudo o que ${princ.name} pensava que queria. `;
  }
  if(vilao){ s += `${vilao.name} comanda a ameaça que dá o tom do filme inteiro. `; }
  if(vilaoBom){ s += `E, contra todas as expectativas, ${vilaoBom.name} vira a virada de mesa que ninguém viu chegar. `; }
  s += `Um filme sobre o que sobra quando todo mundo já jogou suas cartas.`;
  return s;
}
</script>
